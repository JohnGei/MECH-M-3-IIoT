# ============================================================
# Vorlage für die Datei .env
# Kopieren:  Copy-Item .env.example .env   (PowerShell)
#            cp .env.example .env          (Linux/macOS)
# Danach in .env die Platzhalter ersetzen. Die .env wird NIE committet.
# ============================================================

# ------------------------------------------------------------
# InfluxDB (wird beim ersten Start mit diesen Werten eingerichtet)
# ------------------------------------------------------------
INFLUX_URL=http://localhost:8086
INFLUX_ORG=iiot
INFLUX_BUCKET=sensor_data
INFLUX_USER=admin
INFLUX_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN
# Beliebige lange Zufallszeichenkette, z.B. mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
INFLUX_TOKEN=HIER_ZUFAELLIGES_API_TOKEN_EINTRAGEN

# ------------------------------------------------------------
# Grafana-Administrator
# ------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=HIER_SICHERES_GRAFANA_PASSWORT_EINTRAGEN

# ------------------------------------------------------------
# MQTT - Kurs-Broker (Passwort wird in der Vorlesung bekanntgegeben)
# ------------------------------------------------------------
MQTT_HOST=158.180.44.197
MQTT_PORT=1883
MQTT_USER=bobm
MQTT_PASSWORD=HIER_MQTT_PASSWORT_EINTRAGEN
